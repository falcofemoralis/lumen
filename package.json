    "i18next": "^25.10.10",
    "intl-pluralrules": "^2.0.1",
    "lucide-react-native": "^1.27.0",
    "node-html-parser": "^7.1.0",
    "node-webvtt": "^1.9.4",
    "react": "19.2.3",
