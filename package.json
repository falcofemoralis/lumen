    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/firestore": "^25.1.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/react-query": "^5.101.4",
    "expo": "^57.0.8",
    "expo-application": "^57.0.2",
    "expo-build-properties": "^57.0.7",
    "expo-device": "^57.0.1",
    "expo-file-system": "^57.0.1",
    "expo-haptics": "^57.0.1",
