{
  "name": "lumen",
  "version": "0.0.1",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:clean": "npx expo prebuild --clean",
    "lint": "eslint . --fix",
    "lint:check": "eslint src",
    "measure": "flashlight measure",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "sign": "zipalign -f -v 4 android\\app\\build\\outputs\\apk\\release\\app-release.apk release-signed.apk && apksigner sign --ks lumen.keystore --ks-key-alias lumen release-signed.apk",
    "build": "npx expo prebuild --clean --platform android && cd android && gradlew assembleRelease",
    "build:mac": "npx expo prebuild --clean --platform android && cd android && ./gradlew assembleRelease",
    "adb:connect": "adb connect 192.168.1.104",
    "adb:disconnect": "adb disconnect 192.168.1.104",
    "adb:install:dev": "adb install android/app/build/outputs/apk/release/app-release.apk",
    "adb:install:prod": "adb install release-signed.apk",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.7",
    "@kesha-antonov/react-native-background-downloader": "4.6.1",
    "@lodev09/react-native-true-sheet": "^3.11.9",
