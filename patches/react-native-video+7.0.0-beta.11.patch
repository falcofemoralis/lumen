@@ -23,13 +36,20 @@ fun buildBaseDataSourceFactory(context: Context, source: HybridVideoPlayerSource
 
 @OptIn(UnstableApi::class)
 fun buildHttpDataSourceFactory(context: Context, source: HybridVideoPlayerSourceSpec): OkHttpDataSource.Factory {
-  val client = OkHttpClientProvider.getOkHttpClient()
+  val sharedClient = OkHttpClientProvider.getOkHttpClient()
 
   if (context is ReactContext) {
     val handler = ForwardingCookieHandler(context)
-    (client.cookieJar as CookieJarContainer).setCookieJar(JavaNetCookieJar(handler))
+    (sharedClient.cookieJar as CookieJarContainer).setCookieJar(JavaNetCookieJar(handler))
   }
 
+  // derived rather than built from scratch, so the cookie jar set above, the
+  // dispatcher and the connection pool stay the ones the rest of the app uses
+  val client = sharedClient.newBuilder()
+    .connectTimeout(MEDIA_CONNECT_TIMEOUT_MS, TimeUnit.MILLISECONDS)
