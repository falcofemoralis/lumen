+import java.util.concurrent.TimeUnit
 import okhttp3.JavaNetCookieJar
 
+// media3's own defaults for DefaultHttpDataSource. React Native's shared client
+// is built with every timeout set to zero - an infinite one - which is workable
+// for the short requests the app makes itself but not for a media socket. A
+// paused player stops reading as soon as its buffer is full, and an idle
+// connection is routinely dropped by a NAT or a CDN without either end being
+// told; resuming then blocks in a read that never returns, so ExoPlayer neither
+// retries nor reports an error and playback simply runs out the buffer and
+// freezes. With a finite timeout the same situation surfaces as an IOException,
+// which ExoPlayer recovers from by reconnecting.
+private const val MEDIA_CONNECT_TIMEOUT_MS = 8000L
+private const val MEDIA_READ_TIMEOUT_MS = 8000L
+
 fun buildBaseDataSourceFactory(context: Context, source: HybridVideoPlayerSourceSpec): DefaultDataSource.Factory {
